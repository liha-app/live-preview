{
  "name": "@liha-cli/mcp",
  "version": "0.1.1",
  "description": "MCP server for Liha Live Preview: read review feedback and publish new versions from a coding agent.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "liha-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@liha-cli/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "liha-api": "workspace:*"
  },
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "preview",
    "review",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liha-app/live-preview.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/liha-app/live-preview#readme",
  "bugs": {
    "url": "https://github.com/liha-app/live-preview/issues"
  }
}
