# Security headers for the app origin, in Cloudflare Pages `_headers` format.
# Preview content is served by the Worker from a *different* origin and carries
# its own, far stricter, sandbox headers — see apps/api/src/content.ts.
#
# `pnpm run deploy` generates this file from your own hostnames and writes it
# into the build, so a scripted deployment never sees these placeholders. If you
# deploy by hand, update connect-src and frame-src before going live —
# `pnpm verify:deployment` fails if you forget.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.example.net; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.liha.example.com https://*.example.net; frame-src https://*.example.net; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
