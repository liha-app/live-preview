{
  "name": "@liha/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply liha-live-preview --local",
    "db:migrate:remote": "wrangler d1 migrations apply liha-live-preview --remote"
  },
  "dependencies": {
    "@liha/shared": "workspace:*",
    "fflate": "^0.8.2",
    "hono": "^4.6.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.0.0"
  }
}
